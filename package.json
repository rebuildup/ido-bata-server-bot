{
  "name": "ido-bata-server-bot",
  "version": "1.0.0",
  "description": "Discord server bot for ido-bata operations",
  "main": "dist/index.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:stage": "tsx src/scripts/stage-audio-smoke.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1"
  }
}
